---
import { team } from '../data/team';
const supervisors = team.filter(member => member.group === 'leadership' && member.email);
---
<div class="supervision-contact">
  <p>If you share an interest in intelligent networks, connected sensing or secure cyber-physical systems, we would love to hear from you. Enquiries about MSc and PhD supervision can be sent to either of our academic staff:</p>
  <div class="supervision-emails">
    {supervisors.map(member => (
      <div><h3>{member.name}</h3><p>{member.role}</p><a href={`mailto:${member.email}`}>{member.email}</a></div>
    ))}
  </div>
</div>
<style>
  .supervision-emails { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 32px; max-width: 850px; }
  .supervision-emails > div { border-top: 1px solid #cedde3; padding-top: 24px; min-width: 0; }
  .supervision-emails h3 { font-size: 18px; margin: 0 0 8px; color: #163b4b; }
  .supervision-emails p { font-size: 14px; margin: 0 0 12px; }
  .supervision-emails a { color: #007b9c; font-size: 15px; line-height: 1.6; overflow-wrap: anywhere; text-decoration: underline; text-underline-offset: 4px; }
  @media(max-width: 650px) { .supervision-emails { grid-template-columns: 1fr; } }
</style>
