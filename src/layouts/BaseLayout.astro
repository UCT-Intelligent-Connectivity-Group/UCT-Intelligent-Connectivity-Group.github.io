---
import '../styles/global.css';
import StarsCanvas from '../components/StarsCanvas.astro';
import site from '../data/site.json';

const {
  title = 'Intelligent Connectivity Group',
  description = 'Intelligent Connectivity Group at University of Cape Town.',
  headerMode = 'auto',
  bodyClass = '',
  showStars = true
} = Astro.props;

const isSpaceTheme = bodyClass.includes('space-theme');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/logo/icg-icon.svg" />
  </head>
  <body class={bodyClass}>
    <header class={`site-header ${headerMode === 'glass' ? 'is-visible' : ''}`} data-scroll-header data-header-mode={headerMode}>
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Intelligent Connectivity Group home">
          <img class="brand-logo" src={site.logo} alt={site.name} />
        </a>
        <div class="nav-primary" id="primary-navigation">
          <a href="/research/">Research</a>
          <a href="/our-team/">Team</a>
          <a href="/publications/">Publications</a>
          <a href="/news/">News</a>
          <a href="/join-us/">Join Us</a>
          <a href="/contact/">Contact</a>
        </div>
        <a class="institution-tag" href="https://uct.ac.za/" aria-label="University of Cape Town"><img src="/assets/logo/uct.svg" alt="University of Cape Town" width="300" height="44" /></a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-navigation" type="button"><span>Menu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
      </nav>
    </header>
    {isSpaceTheme && showStars && <StarsCanvas />}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="main-content" tabindex="-1"><slot /></div>
    <footer class="footer">
      <div class="footer-main">
        <section class="footer-brand" aria-labelledby="footer-brand-title">
          <a class="footer-brand-name" href="/" id="footer-brand-title">{site.name}</a>
          <h2
          >{site.department}</h2>
          <p
            class="footer-university"
          >{site.university}</p>
          <p
            class="footer-description"
          >Intelligence, networks and connected systems. Research from Cape Town.</p>
          <address
          >{site.address}</address>

        </section>

        <nav class="footer-column" aria-labelledby="footer-navigation-title">
          <h3 id="footer-navigation-title">Navigate</h3>
          <a href="/research/">Research</a>
          <a href="/our-team/">Team</a>
          <a href="/publications/">Publications</a>
          <a href="/news/">News</a>
        </nav>

        <nav class="footer-column" aria-labelledby="footer-connect-title">
          <h3 id="footer-connect-title">Connect</h3>
          <a href="/join-us/">Join Us</a>
          <a href="/contact/">Contact</a>
          <a href="https://github.com/choucisan/SpaceLab" target="_blank" rel="noreferrer">Website Template</a>
        </nav>

        <nav class="footer-column" aria-labelledby="footer-institution-title">
          <h3 id="footer-institution-title">Institution</h3>
          <a href="https://uct.ac.za/" target="_blank" rel="noreferrer">University of Cape Town</a>
          <a href="https://ebe.uct.ac.za/department-electrical-engineering" target="_blank" rel="noreferrer">Electrical Engineering</a>
          <a href="/about/">About the group</a>
        </nav>
      </div>

      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span
        >Department of Electrical Engineering, UCT</span>
      </div>
    </footer>
    <script>
      document.querySelector('.site-header')?.classList.add('nav-ready');
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-navigation');
      const closeMenu = () => { toggle?.setAttribute('aria-expanded', 'false'); navigation?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); navigation?.classList.toggle('is-open', open); });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
      window.matchMedia('(min-width: 961px)').addEventListener('change', closeMenu);

      const header = document.querySelector<HTMLElement>('[data-scroll-header]');
      const hero = document.querySelector<HTMLElement>('.hero');

      const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

      const updateScene = () => {
        const fixedGlass = header?.dataset.headerMode === 'glass';
        header?.classList.toggle('is-visible', fixedGlass || window.scrollY > 80);

        if (!hero) return;

        const progress = clamp(window.scrollY / Math.min(hero.clientHeight * 0.34, 420), 0, 1);
        const cloudDriftX = -progress * Math.min(window.innerWidth * 0.22, 360);
        const cloudDriftY = -progress * Math.min(window.innerHeight * 0.18, 150);
        const geeseDriftX = progress * Math.min(window.innerWidth * 0.16, 260);
        const geeseDriftY = -progress * Math.min(window.innerHeight * 0.06, 54);

        hero.style.setProperty('--hero-cloud-drift-x', `${cloudDriftX}px`);
        hero.style.setProperty('--hero-cloud-drift-y', `${cloudDriftY}px`);
        hero.style.setProperty('--hero-geese-drift-x', `${geeseDriftX}px`);
        hero.style.setProperty('--hero-geese-drift-y', `${geeseDriftY}px`);
      };

      updateScene();
      window.addEventListener('scroll', updateScene, { passive: true });
      window.addEventListener('resize', updateScene);

      const revealScenes = document.querySelectorAll('[data-reveal-scene]');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
      }, { threshold: 0.28 });

      revealScenes.forEach((scene) => revealObserver.observe(scene));

    </script>
  </body>
</html>
